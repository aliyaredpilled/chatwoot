FROM node:24-slim AS frontend-builder

COPY --from=chatwoot/chatwoot:latest /app /app
WORKDIR /app

# Copy the current fork worktree instead of a hand-maintained file list.
# This keeps local image deploys aligned with the actual checkout.
COPY package.json pnpm-lock.yaml postcss.config.js tailwind.config.js vite.config.ts .browserslistrc /app/
COPY app /app/app
COPY config /app/config
COPY db /app/db
COPY enterprise /app/enterprise
COPY public /app/public

# Install pnpm and rebuild
RUN npm install -g pnpm@10 && cd /app && pnpm install --frozen-lockfile && SECRET_KEY_BASE=precompile_placeholder RAILS_ENV=production NODE_OPTIONS="--max-old-space-size=4096" npx vite build

# Final image
FROM chatwoot/chatwoot:latest

WORKDIR /app

# Copy rebuilt frontend assets
COPY --from=frontend-builder /app/public/vite /app/public/vite

# Copy the current Ruby app/config/db state from the fork.
COPY app /app/app
COPY config /app/config
COPY db /app/db
COPY enterprise /app/enterprise
